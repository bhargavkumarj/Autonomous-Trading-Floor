# ---- required -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- optional: everything below degrades gracefully if unset --------------

# Live market data. Without it, prices come from the built-in simulator and the
# whole floor still runs end to end.
# MASSIVE_API_KEY=

# Web search for the researcher sub-agent. Without it the researcher falls back
# to fetching pages directly.
# TAVILY_API_KEY=

# Push notifications to your phone at the end of each trader's run. Without
# these the push tool logs instead of sending.
# PUSHOVER_USER=
# PUSHOVER_TOKEN=

# Extra providers, only needed with USE_MANY_MODELS=true
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
# GROK_API_KEY=
# OPENROUTER_API_KEY=

# ---- behaviour ------------------------------------------------------------
# DEFAULT_MODEL=gpt-5.4-mini
# USE_MANY_MODELS=false          # run each trader on a different frontier model
# RUN_EVERY_N_MINUTES=60
# RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
# INITIAL_BALANCE=10000
# SPREAD=0.002
# MAX_TURNS=30
# TRADING_FLOOR_DB=./accounts.db
